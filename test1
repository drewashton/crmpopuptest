<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Penticton Robotics Newsletter</title>

  <style>
  body {
    margin: 0;
    background: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
  }

  /* Overlay */
  .newsletter-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  /* Popup */
  .newsletter-popup {
    background: #F2BE4C;
    max-width: 560px;
    width: 92%;
    padding: 40px;
    border-radius: 20px;
    position: relative;
    text-align: center;
    box-shadow: 0 25px 70px rgba(0,0,0,0.35);
  }

  /* Close */
  .newsletter-close {
    position: absolute;
    top: 18px;
    right: 18px;
    font-size: 20px;
    cursor: pointer;
    color: #000;
    opacity: 0.6;
  }

  .newsletter-close:hover {
    opacity: 1;
  }

  /* Logo placeholder */
  .newsletter-logo {
    font-weight: 700;
    margin-bottom: 18px;
  }

  /* Title */
  .newsletter-popup h2 {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 10px;
    color: #000;
  }

  /* Subtitle */
  .newsletter-popup p {
    font-size: 16px;
    color: #000;
    margin-bottom: 28px;
  }

  /* Inputs */
  .newsletter-popup input {
    width: 100%;
    padding: 14px 16px;
    font-size: 15px;
    border: none;
    border-radius: 6px;
    margin-bottom: 14px;
    box-sizing: border-box;
  }

  /* Button */
  .newsletter-popup button {
    margin-top: 10px;
    padding: 14px 32px;
    background: #000;
    color: #F2BE4C;
    font-weight: 800;
    font-size: 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }

  .newsletter-popup button:hover {
    background: #111;
  }

  </style>
</head>

<body>

  <!-- POPUP -->
  <div class="newsletter-overlay" id="newsletterPopup">
    <div class="newsletter-popup">

